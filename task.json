{
  "$comment": "Machine-readable form of README.md. This repository carries ten deterministic boards; see `tasks`. No Lean toolchain \u2014 every checker is plain Python 3.12 and the image is built from the Dockerfile at this root.",
  "board": "practice-problems",
  "title": "Practice problems \u2014 deterministic boards with known answers",
  "platform": "problem.market",
  "tier": "deterministic",
  "status": "open",
  "checker": {
    "language": "python",
    "version": "3.12",
    "entrypoint": "./run.sh <board> <submission.json>",
    "image": "Dockerfile",
    "sandbox": [
      "--network none",
      "--read-only",
      "--cap-drop ALL"
    ]
  },
  "additionalDependenciesAllowed": false,
  "prerequisites": {
    "tools": [
      "git",
      "python3"
    ],
    "freeDiskGB": 1
  },
  "exitCodes": {
    "0": "valid \u2014 the submission is accepted",
    "1": "invalid \u2014 the submission is wrong; the message says how",
    "2": "unreadable \u2014 the file is not in the stated format; no verdict",
    "4": "checker failed \u2014 never a verdict against a submission"
  },
  "winConditions": {
    "checkerExitZero": true
  },
  "protectedPaths": [
    ".github/",
    "boards.tsv",
    "verify.sh",
    "run.sh",
    "Dockerfile",
    "task.json",
    "*/check.py",
    "*/examples/"
  ],
  "selfCheck": "./verify.sh <board>",
  "$comment_tasks": "One entry per board. `id` is filled in as each board is posted; `criteriaCommit` is the commit that board pins.",
  "tasks": [
    {
      "board": "debruijn26",
      "checker": "debruijn26/check.py",
      "statement": "tasks/debruijn26.md",
      "title": "De Bruijn sequence B(2,6)",
