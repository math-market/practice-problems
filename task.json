    "0": "valid — the submission is accepted",
    "1": "invalid — the submission is wrong; the message says how",
    "2": "unreadable — the file is not in the stated format; no verdict",
    "4": "checker failed — never a verdict against a submission"
  },
  "winConditions": {"checkerExitZero": true},
  "protectedPaths": [
    ".github/", "boards.tsv", "verify.sh", "run.sh", "Dockerfile", "task.json",
    "*/check.py", "*/examples/"
  ],
  "selfCheck": "./verify.sh <board>",
